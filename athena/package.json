{
  "name": "athena",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n vite,electron \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build": "vite build",
    "start": "electron .",
    "lint": "eslint .",
    "test": "node --test \"src/lib/**/*.test.js\"",
    "preview": "vite preview",
    "dist": "npm run build && electron-builder --mac dmg"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@eslint/js": "^10.0.1",
    "@rolldown/plugin-babel": "^0.2.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vite": "^8.3.4",
    "wait-on": "^9.5.1"
  },
  "description": "Athena online examination desktop app",
  "main": "app/main.js",
  "keywords": [],
  "author": "Yatin Singh",
  "license": "ISC",
  "build": {
    "appId": "com.yatinsingh.athena",
    "productName": "Athena",
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "files": [
      "app/**",
      "dist/**",
      "build/icon.png"
    ],
    "mac": {
      "category": "public.app-category.education",
      "icon": "build/icon.png",
      "identity": null,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "extendInfo": {
        "NSCameraUsageDescription": "Athena needs your camera for the system check before a test.",
        "NSMicrophoneUsageDescription": "Athena needs your microphone for the system check before a test."
      }
    },
    "dmg": {
      "title": "Athena ${version}"
    }
  }
}
