{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "mkdir -p public",
  "outputDirectory": "public",
  "functions": {
    "api/index.js": {
      "includeFiles": "data/{users,questions}.json"
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api" }]
}
